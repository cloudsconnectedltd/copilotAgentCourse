{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.4",
  "body": [
    {
      "type": "TextBlock",
      "text": "CRITICAL field report: ${ReportId}",
      "weight": "Bolder",
      "size": "Large",
      "color": "Attention",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Harbourline Energy Co. | HLE Field Report Triage",
      "isSubtle": true,
      "spacing": "None",
      "wrap": true
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Report date", "value": "${ReportDate}" },
        { "title": "Region", "value": "${Region}" },
        { "title": "Asset", "value": "${AssetId} (${AssetSite})" },
        { "title": "Crew", "value": "${CrewId}, ${CrewLeader}" },
        { "title": "Work order", "value": "${WorkOrderNumber} (Emergency, Emergency Restoration)" },
        { "title": "Source file", "value": "${FileName}" },
        { "title": "Submitted by", "value": "${SubmittedBy}" }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Issue",
      "weight": "Bolder",
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "${Issue}",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Recommended action",
      "weight": "Bolder",
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "${RecommendedAction}",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Crew notes",
      "weight": "Bolder",
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "${CrewNotes}",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Generated by an autonomous agent running with the maker's credentials. Verify on site before acting.",
      "isSubtle": true,
      "size": "Small",
      "wrap": true,
      "spacing": "Medium"
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Open Incoming folder",
      "url": "https://<tenant>.sharepoint.com/sites/<Prefix>-Harbourline-Operations/Procedures/Incoming"
    }
  ]
}
